{%- assign show_enhanced = false -%}
{%- if collection.handle == 'taylormade' -%}
  {%- assign show_enhanced = true -%}
{%- endif -%}

{%- if show_enhanced -%}

<div class="enhanced-collection wrapper-spacing--h" data-section-id="{{ section.id }}">
  <div class="width--content">

    <div class="enhanced-collection__hero">
      {%- if section.settings.eyebrow != blank -%}
        <p class="enhanced-collection__eyebrow label-font">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="enhanced-collection__title">{{ section.settings.heading | default: collection.title }}</h1>
      {%- if section.settings.intro != blank -%}
        <div class="enhanced-collection__intro rte">{{ section.settings.intro }}</div>
      {%- elsif collection.description != blank -%}
        <div class="enhanced-collection__intro rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- assign featured_limit = section.settings.featured_count | default: 10 -%}

    <div class="enhanced-collection__section">
      <div class="enhanced-collection__section-header">
        <h2 class="enhanced-collection__section-title">{{ section.settings.featured_heading | default: 'All products' }}</h2>
        <a href="{{ collection.url }}" class="enhanced-collection__view-all link text-link-animated">
          {{ section.settings.featured_cta | default: 'View all products' }} &rarr;
        </a>
      </div>
      {%- if section.settings.featured_desc != blank -%}
        <p class="enhanced-collection__section-desc">{{ section.settings.featured_desc }}</p>
      {%- endif -%}
      <div class="enhanced-collection__carousel enhanced-collection__carousel--2row enhanced-collection__carousel--{{ section.settings.featured_per_row }}col">
        {%- for product in collection.products limit: featured_limit -%}
          <div class="enhanced-collection__card-wrap">
            {%- render 'grid-view-item',
              product: product,
              collection: collection,
              enable_badges: settings.show_badges,
              grid_count_desktop: section.settings.featured_per_row,
              grid_count_mobile: 2,
              loading: 'lazy'
            -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'sub_carousel' -%}

        {%- assign filter_type = block.settings.filter_type -%}
        {%- assign filter_tag = block.settings.filter_tag -%}
        {%- assign sub_limit = block.settings.products_shown | default: 4 -%}

        {%- assign sub_products = collection.products | where: 'type', filter_type -%}
        {%- if sub_products.size == 0 and filter_tag != blank -%}
          {%- assign sub_products = collection.products | where: 'tags', filter_tag -%}
        {%- endif -%}
        {%- if sub_products.size == 0 -%}
          {%- assign sub_products = collection.products -%}
        {%- endif -%}

        {%- assign filter_url = collection.url -%}
        {%- if block.settings.filter_param != blank -%}
          {%- assign filter_url = collection.url | append: '?' | append: block.settings.filter_param -%}
        {%- endif -%}

        <div class="enhanced-collection__section" {{ block.shopify_attributes }}>
          <div class="enhanced-collection__section-header">
            <h2 class="enhanced-collection__section-title">{{ block.settings.heading }}</h2>
            <a href="{{ filter_url }}" class="enhanced-collection__view-all link text-link-animated">
              {{ block.settings.cta | default: 'View all' }} &rarr;
            </a>
          </div>
          {%- if block.settings.description != blank -%}
            <div class="enhanced-collection__section-desc rte">{{ block.settings.description }}</div>
          {%- endif -%}
          <div class="enhanced-collection__carousel enhanced-collection__carousel--1row enhanced-collection__carousel--{{ sub_limit }}col">
            {%- for product in sub_products limit: sub_limit -%}
              <div class="enhanced-collection__card-wrap">
                {%- render 'grid-view-item',
                  product: product,
                  collection: collection,
                  enable_badges: settings.show_badges,
                  grid_count_desktop: sub_limit,
                  grid_count_mobile: 2,
                  loading: 'lazy'
                -%}
              </div>
            {%- endfor -%}
          </div>
        </div>

      {%- endif -%}
    {%- endfor -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'split_block' -%}
        <div class="enhanced-collection__split enhanced-collection__split--{{ block.settings.image_position }}" {{ block.shopify_attributes }}>
          <div class="enhanced-collection__split-img">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
            {%- else -%}
              <div class="enhanced-collection__split-img-placeholder"></div>
            {%- endif -%}
          </div>
          <div class="enhanced-collection__split-text">
            {%- if block.settings.eyebrow != blank -%}
              <p class="enhanced-collection__eyebrow label-font">{{ block.settings.eyebrow }}</p>
            {%- endif -%}
            <h2 class="enhanced-collection__split-heading">{{ block.settings.heading }}</h2>
            {%- if block.settings.text != blank -%}
              <div class="enhanced-collection__split-body rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.cta_label != blank and block.settings.cta_url != blank -%}
              <a href="{{ block.settings.cta_url }}" class="btn enhanced-collection__split-cta">
                {{ block.settings.cta_label }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

  </div>
</div>

<style>
  .enhanced-collection {
    padding-top: 3rem;
    padding-bottom: 2rem;
  }
  .enhanced-collection__hero {
    margin-bottom: 3.5rem;
  }
  .enhanced-collection__eyebrow {
    margin-bottom: 0.6rem;
    opacity: 0.7;
    font-size: 1.2rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .enhanced-collection__title {
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    margin-bottom: 1.2rem;
  }
  .enhanced-collection__intro {
    max-width: 68ch;
    opacity: 0.8;
  }
  .enhanced-collection__section {
    margin-bottom: 4rem;
  }
  .enhanced-collection__section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 0.6rem;
  }
  .enhanced-collection__section-title {
    font-size: clamp(1.8rem, 2.5vw, 2.4rem);
    margin: 0;
  }
  .enhanced-collection__view-all {
    font-size: 1.3rem;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .enhanced-collection__section-desc {
    margin-bottom: 1.6rem;
    opacity: 0.75;
    max-width: 72ch;
    font-size: 1.4rem;
    line-height: 1.6;
  }
  .enhanced-collection__carousel {
    display: grid;
    gap: 1.2rem;
  }
  .enhanced-collection__carousel--2row {
    grid-template-columns: repeat(5, 1fr);
  }
  .enhanced-collection__carousel--1row.enhanced-collection__carousel--4col {
    grid-template-columns: repeat(4, 1fr);
  }
  .enhanced-collection__carousel--1row.enhanced-collection__carousel--3col {
    grid-template-columns: repeat(3, 1fr);
  }
  .enhanced-collection__card-wrap {
    width: 100% !important;
    padding: 0 !important;
    float: none !important;
  }
  .enhanced-collection__card-wrap > * {
    width: 100% !important;
  }
  .enhanced-collection__split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: var(--border-radius, 8px);
    overflow: hidden;
    margin-bottom: 2rem;
    border: 1px solid var(--border-color);
  }
  .enhanced-collection__split--right {
    direction: rtl;
  }
  .enhanced-collection__split--right > * {
    direction: ltr;
  }
  .enhanced-collection__split-img {
    min-height: 320px;
    overflow: hidden;
  }
  .enhanced-collection__split-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .enhanced-collection__split-img-placeholder {
    width: 100%;
    height: 100%;
    min-height: 320px;
    background: var(--color-secondary-background, #f5f5f5);
  }
  .enhanced-collection__split-text {
    padding: 4rem 4.8rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .enhanced-collection__split-heading {
    font-size: clamp(2rem, 2.5vw, 2.8rem);
    margin-bottom: 1.2rem;
  }
  .enhanced-collection__split-body {
    margin-bottom: 2rem;
    opacity: 0.8;
    font-size: 1.4rem;
    line-height: 1.75;
  }
  .enhanced-collection__split-cta {
    align-self: flex-start;
  }
  @media screen and (max-width: 1024px) {
    .enhanced-collection__carousel--2row {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media screen and (max-width: 767px) {
    .enhanced-collection__carousel--2row,
    .enhanced-collection__carousel--1row {
      grid-template-columns: repeat(2, 1fr);
    }
    .enhanced-collection__split {
      grid-template-columns: 1fr;
      direction: ltr !important;
    }
    .enhanced-collection__split-text {
      padding: 2.4rem 2rem;
    }
    .enhanced-collection__split-img {
      min-height: 220px;
    }
  }
</style>

{%- endif -%}

{% schema %}
{
  "name": "Enhanced collection",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "placeholder": "e.g. Shop by brand"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "H1 heading",
      "info": "Leave blank to use collection title"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "info": "Leave blank to use collection description"
    },
    {
      "type": "header",
      "content": "Featured carousel"
    },
    {
      "type": "text",
      "id": "featured_heading",
      "label": "Section heading",
      "default": "All products"
    },
    {
      "type": "text",
      "id": "featured_cta",
      "label": "View all label",
      "default": "View all products"
    },
    {
      "type": "richtext",
      "id": "featured_desc",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "featured_count",
      "label": "Number of products",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "featured_per_row",
      "label": "Columns",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "sub_carousel",
      "name": "Sub-carousel",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "View all label",
          "default": "View all"
        },
        {
          "type": "text",
          "id": "filter_type",
          "label": "Filter by product type",
          "info": "Must match the Product type field exactly in Shopify admin"
        },
        {
          "type": "text",
          "id": "filter_tag",
          "label": "Filter by tag (fallback)"
        },
        {
          "type": "text",
          "id": "filter_param",
          "label": "Filter URL parameter",
          "info": "e.g. filter.p.product_type=Weights+for+Putters"
        },
        {
          "type": "range",
          "id": "products_shown",
          "label": "Products to show",
          "min": 3,
          "max": 6,
          "step": 1,
          "default": 4
        }
      ]
    },
    {
      "type": "split_block",
      "name": "Text and image",
      "settings": [
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow text"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Body text"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Button URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Enhanced layout"
    }
  ]
}
{% endschema %}
