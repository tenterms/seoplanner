  }
  @media screen and (max-width: 767px) {
    .ec__hero-inner { padding: 4rem 0 8rem; }
    .ec__stat b { font-size: 1.6rem; }
    .ec__finder { padding: 2rem 1.8rem 1.8rem; }
    .ec__sec { padding-top: 3.4rem; }
    .ec__sec--tint { padding: 2rem 1.6rem 1.4rem; margin-left: -1.6rem; margin-right: -1.6rem; border-radius: 0; }
    .ec__card-wrap { flex-basis: clamp(14rem, 42vw, 18rem); }
    .ec__band-inner { grid-template-columns: 1fr; gap: 2.8rem; padding-top: 4rem; padding-bottom: 4rem; }
    .ec__how { grid-template-columns: 1fr; }
    .ec__split { grid-template-columns: 1fr; direction: ltr !important; }
    .ec__split-text { padding: 2.4rem 2rem; }
    .ec__split-img { min-height: 220px; }
  }
</style>

{%- endif -%}

