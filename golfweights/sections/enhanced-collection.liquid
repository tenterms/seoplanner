{%- comment -%}
  Enhanced brand collection layout (fit-finder direction).
  - Rollout via "Enabled collection handles" (comma-separated).
  - [brand] token in any text is replaced with the collection title (see brand overrides).
  - Per-brand SEO copy comes from COLLECTION METAFIELDS (namespace: custom) and falls
    back to section/block settings: intro, models, gram_range, hero_image, faqs, and
    any key referenced by a sub-carousel's "Metafield key" setting.
  - Sub-carousels auto-hide when the collection has no matching products.
  - On filtered views a compact hero renders instead and the standard grid shows.
  - On enhanced (unfiltered) views the theme's collection header and product grid
    sections are suppressed — the enhanced layout is the whole page.
{%- endcomment -%}

{%- assign allowed_handles = section.settings.enabled_handles | default: '' | downcase | replace: ' ', '' | split: ',' -%}

{%- assign active_filter_count = 0 -%}
{%- for f in collection.filters -%}
  {%- assign active_filter_count = active_filter_count | plus: f.active_values.size -%}
{%- endfor -%}

{%- if allowed_handles contains collection.handle -%}

{%- assign brand = collection.title -%}
{%- assign override_pairs = section.settings.brand_overrides | default: '' | split: ',' -%}
{%- for pair in override_pairs -%}
  {%- assign pair_parts = pair | split: ':' -%}
  {%- assign pair_handle = pair_parts[0] | strip | downcase -%}
  {%- if pair_handle == collection.handle and pair_parts[1] != blank -%}
    {%- assign brand = pair_parts[1] | strip -%}
  {%- endif -%}
{%- endfor -%}
{%- assign brand_url = brand | url_encode -%}
{%- assign brand_dc = brand | downcase -%}
{%- assign accent = section.settings.accent_color | default: '#02964f' -%}
{%- assign herobg = section.settings.hero_bg | default: '#062d1c' -%}

{%- if active_filter_count > 0 -%}

  {%- comment -%} ============ FILTERED VIEW: compact hero, standard grid below ============ {%- endcomment -%}
  <style>
    .collection-header__title, .collection-header__description { display: none !important; }
  </style>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.collection-header__title, .collection-header__description').forEach(function (el) { el.remove(); });
    });
  </script>

  {%- assign label_map = section.settings.filter_labels | default: '' | split: ',' -%}
  {%- capture active_labels -%}
    {%- assign first_label = true -%}
    {%- for f in collection.filters -%}
      {%- for v in f.active_values -%}
        {%- assign lbl = v.label -%}
        {%- for m in label_map -%}
          {%- assign mp = m | split: ':' -%}
          {%- assign mkey = mp[0] | strip -%}
          {%- if mkey == v.label and mp[1] != blank -%}{%- assign lbl = mp[1] | strip -%}{%- endif -%}
        {%- endfor -%}
        {%- unless first_label %} & {% endunless -%}{{ lbl }}{%- assign first_label = false -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- endcapture -%}

  <div class="ec ec--filtered wrapper-spacing--h" data-section-id="{{ section.id }}">
    <div class="width--content">
      <div class="ec__fhero">
        <p class="ec__eyebrow"><a class="ec__back" href="{{ collection.url }}">&larr; All {{ brand }} products</a></p>
        <h1 class="ec__h1">{{ brand }} {{ active_labels | strip }}</h1>
        <p class="ec__count">{{ collection.products_count }} product{% if collection.products_count != 1 %}s{% endif %}</p>
      </div>
    </div>
  </div>

{%- else -%}

  {%- comment -%} ============ ENHANCED VIEW ============ {%- endcomment -%}

  {%- comment -%} Suppress the theme's collection header and product grid on this page only {%- endcomment -%}
  <style>
    [data-wetheme-section-type="collection-header"],
    [data-wetheme-section-type="template--collection"] { display: none !important; }
  </style>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('[data-wetheme-section-type="collection-header"], [data-wetheme-section-type="template--collection"]').forEach(function (el) { el.remove(); });
    });
  </script>

  {%- comment -%} ---- per-collection metafields ---- {%- endcomment -%}
  {%- capture mf_intro -%}{{ collection.metafields.custom.intro | metafield_tag }}{%- endcapture -%}
  {%- capture mf_faqs -%}{{ collection.metafields.custom.faqs | metafield_tag }}{%- endcapture -%}
  {%- assign mf_gram_range = collection.metafields.custom.gram_range.value -%}
  {%- assign hero_img = collection.metafields.custom.hero_image.value | default: section.settings.hero_image -%}

  {%- comment -%} ---- models config: one per line "Label | exact tag | clubs" ---- {%- endcomment -%}
  {%- assign models_raw = collection.metafields.custom.models.value | default: '' -%}
  {%- assign model_lines = models_raw | strip | newline_to_br | split: '<br />' -%}

  {%- comment -%} ---- pre-count sub-carousel blocks (chips, auto-hide, counts) ---- {%- endcomment -%}
  {%- assign block_counts = '' -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign block_total = 0
      if block.type == 'sub_carousel'
        assign ftype = block.settings.filter_type | strip
        assign ftag = block.settings.filter_tag | strip | downcase
        assign pool = collection.products
        if block.settings.source_collection != blank
          assign source_col = collections[block.settings.source_collection]
          if source_col.products.size > 0
            assign pool = source_col.products
          endif
        endif
        for product in pool
          assign is_match = true
          if ftype == blank and ftag == blank and block.settings.vendor_match == false
            assign is_match = false
          endif
          if ftype != blank and product.type != ftype
            assign is_match = false
          endif
          if is_match and ftag != blank
            assign tag_string = product.tags | join: '|' | downcase
            unless tag_string contains ftag
              assign is_match = false
            endunless
          endif
          if is_match and block.settings.vendor_match
            assign vendor_dc = product.vendor | downcase
            if vendor_dc != brand_dc
              unless vendor_dc contains 'universal'
                assign is_match = false
              endunless
            endif
          endif
          if is_match
            assign block_total = block_total | plus: 1
          endif
        endfor
      endif
      assign block_counts = block_counts | append: block_total | append: ','
    -%}
  {%- endfor -%}
  {%- assign block_counts_arr = block_counts | split: ',' -%}

  {%- comment -%} ---- which clubs exist here (drives finder buttons + product JSON) ---- {%- endcomment -%}
  {%- liquid
    assign has_driver = false
    assign has_fairway = false
    assign has_hybrid = false
    assign has_iron = false
    assign has_putter = false
    assign has_kits = false
    for product in collection.products
      assign ptags = product.tags | join: '|' | downcase
      if product.type == 'Weights for Woods'
        if ptags contains 'driver'
          assign has_driver = true
        endif
        if ptags contains 'fairway'
          assign has_fairway = true
        endif
        if ptags contains 'hybrid'
          assign has_hybrid = true
        endif
      endif
      if product.type == 'Weights for Irons'
        assign has_iron = true
      endif
      if product.type == 'Weights for Putters'
        assign has_putter = true
      endif
      if ptags contains 'weight kit'
        assign has_kits = true
      endif
    endfor
  -%}

  <div class="ec" data-section-id="{{ section.id }}">

    {%- comment -%} ================= HERO ================= {%- endcomment -%}
    <header class="ec__hero"{% if hero_img %} style="background-image: url('{{ hero_img | image_url: width: 2400 }}');"{% endif %}>
      <div class="ec__hero-scrim" aria-hidden="true"></div>
      <div class="ec__wrap">
        <div class="ec__hero-inner">
          {%- if section.settings.eyebrow != blank -%}
            <p class="ec__eyebrow ec__eyebrow--hero">{{ section.settings.eyebrow | replace: '[brand]', brand }}</p>
          {%- endif -%}
          <h1 class="ec__h1 ec__h1--hero">{%- if section.settings.heading != blank -%}{{ section.settings.heading | replace: '[brand]', brand }}{%- else -%}{{ brand }} Golf Club Weights{%- endif -%}</h1>
          <div class="ec__lede">
            {%- if mf_intro != blank -%}
              {{ mf_intro }}
            {%- elsif section.settings.intro != blank -%}
              {{ section.settings.intro | replace: '[brand]', brand }}
            {%- elsif collection.description != blank -%}
              {{ collection.description }}
            {%- endif -%}
          </div>
          <div class="ec__stats">
            <div class="ec__stat"><b>{{ collection.products_count }}</b><span>products</span></div>
            {%- if model_lines.size > 1 -%}
              {%- assign first_model = model_lines.first | split: '|' -%}
              {%- assign last_model = model_lines.last | split: '|' -%}
              <div class="ec__stat"><b>{{ first_model[0] | strip }} &rarr; {{ last_model[0] | strip }}</b><span>models covered</span></div>
            {%- endif -%}
            {%- if mf_gram_range != blank -%}
              <div class="ec__stat"><b>{{ mf_gram_range }}</b><span>weight range</span></div>
            {%- endif -%}
            {%- if section.settings.stat_extra_value != blank -%}
              <div class="ec__stat"><b>{{ section.settings.stat_extra_value }}</b><span>{{ section.settings.stat_extra_label }}</span></div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </header>

    {%- comment -%} ================= FIT FINDER ================= {%- endcomment -%}
    {%- if section.settings.show_finder and model_lines.size > 0 and models_raw != blank -%}
    <div class="ec__wrap ec__finder-shell">
      <div class="ec__finder">
        <div class="ec__finder-head">
          <h2 class="ec__finder-title">{{ section.settings.finder_heading | default: 'Find weights for your [brand]' | replace: '[brand]', brand }}</h2>
          <span class="ec__finder-sub">{{ section.settings.finder_sub | default: 'Two taps — see exactly what fits.' }}</span>
        </div>
        <p class="ec__step-label">1 &middot; Your club</p>
        <div class="ec__seg" id="ecClubSeg" role="group" aria-label="Club type">
          {%- if has_driver -%}<button type="button" data-club="driver" aria-pressed="false">Driver</button>{%- endif -%}
          {%- if has_fairway -%}<button type="button" data-club="fairway" aria-pressed="false">Fairway</button>{%- endif -%}
          {%- if has_hybrid -%}<button type="button" data-club="hybrid" aria-pressed="false">Hybrid</button>{%- endif -%}
          {%- if has_iron -%}<button type="button" data-club="iron" aria-pressed="false">Irons</button>{%- endif -%}
          {%- if has_putter -%}<button type="button" data-club="putter" aria-pressed="false">Putter</button>{%- endif -%}
        </div>
        <p class="ec__step-label">2 &middot; Your model</p>
        <div class="ec__models" id="ecModelChips"><span class="ec__hint">Pick a club type first&hellip;</span></div>
        <div class="ec__finder-results" id="ecFinderResults" hidden>
          <div class="ec__fr-head">
            <h3 id="ecFrTitle">Weights that fit</h3>
            <button type="button" id="ecFrClear">Clear</button>
          </div>
          <div class="ec__fr-row" id="ecFrRow"></div>
        </div>
      </div>
    </div>
    {%- endif -%}

    {%- comment -%} ================= STICKY SUBNAV ================= {%- endcomment -%}
    {%- capture subnav_links -%}
      <a href="#ec-featured" class="on">All products</a>
      {%- if models_raw != blank -%}<a href="#ec-models">Shop by model</a>{%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'sub_carousel' -%}
          {%- assign nav_count = block_counts_arr[forloop.index0] | plus: 0 -%}
          {%- if nav_count > 0 -%}
            {%- assign nav_label = block.settings.heading | replace: '[brand]', '' | strip | capitalize -%}
            <a href="#ec-{{ block.id }}">{{ nav_label }}</a>
          {%- endif -%}
        {%- endif -%}
        {%- if block.type == 'feature_band' and has_kits -%}
          <a href="#ec-band-{{ block.id }}">{{ block.settings.nav_label | default: 'Weight kits' }}</a>
        {%- endif -%}
      {%- endfor -%}
      {%- assign has_faq_blocks = false -%}
      {%- for block in section.blocks -%}{%- if block.type == 'faq' -%}{%- assign has_faq_blocks = true -%}{%- endif -%}{%- endfor -%}
      {%- if mf_faqs != blank or has_faq_blocks -%}<a href="#ec-faqs">FAQs</a>{%- endif -%}
    {%- endcapture -%}
    <div class="ec__subnav" id="ecSubnav"><div class="ec__subnav-inner">{{ subnav_links }}</div></div>

    <div class="ec__wrap">

      {%- comment -%} ================= FEATURED / ALL PRODUCTS ================= {%- endcomment -%}
      {%- assign featured_limit = section.settings.featured_count | default: 5 -%}
      {%- assign shown_global = ',' -%}
      <section class="ec__sec" id="ec-featured">
        <span class="ec__rule" aria-hidden="true"></span>
        <div class="ec__sec-head">
          <h2 class="ec__h2">{%- if section.settings.featured_heading != blank -%}{{ section.settings.featured_heading | replace: '[brand]', brand }}{%- else -%}All {{ brand }} products{%- endif -%}</h2>
        </div>
        {%- capture mf_featured -%}{{ collection.metafields.custom.featured_intro | metafield_tag }}{%- endcapture -%}
        {%- if mf_featured != blank -%}
          <div class="ec__sec-desc rte">{{ mf_featured }}</div>
        {%- elsif section.settings.featured_desc != blank -%}
          <div class="ec__sec-desc rte">{{ section.settings.featured_desc | replace: '[brand]', brand }}</div>
        {%- endif -%}
        <div class="ec__carousel">
          {%- for product in collection.products limit: featured_limit -%}
            {%- assign shown_global = shown_global | append: product.handle | append: ',' -%}
            <div class="ec__card-wrap">
              {%- render 'grid-view-item', product: product, collection: collection, enable_badges: settings.show_badges, grid_count_desktop: 4, grid_count_mobile: 2, loading: 'lazy' -%}
            </div>
          {%- endfor -%}
        </div>
      </section>

      {%- comment -%} ================= MODEL RAIL ================= {%- endcomment -%}
      {%- if models_raw != blank -%}
      <section class="ec__sec" id="ec-models">
        <span class="ec__rule" aria-hidden="true"></span>
        <div class="ec__sec-head">
          <h2 class="ec__h2">{{ section.settings.models_heading | default: 'Shop by model' | replace: '[brand]', brand }}</h2>
        </div>
        {%- capture mf_models_intro -%}{{ collection.metafields.custom.models_intro | metafield_tag }}{%- endcapture -%}
        {%- if mf_models_intro != blank -%}
          <div class="ec__sec-desc rte">{{ mf_models_intro }}</div>
        {%- elsif section.settings.models_desc != blank -%}
          <div class="ec__sec-desc rte">{{ section.settings.models_desc | replace: '[brand]', brand }}</div>
        {%- endif -%}
        <div class="ec__carousel ec__carousel--models">
          {%- for line in model_lines -%}
            {%- assign mparts = line | split: '|' -%}
            {%- assign mlabel = mparts[0] | strip -%}
            {%- assign mtag = mparts[1] | strip | downcase -%}
            {%- if mlabel == blank or mtag == blank -%}{%- continue -%}{%- endif -%}
            {%- assign mtag_key = '|' | append: mtag | append: '|' -%}
            {%- assign mcount = 0 -%}
            {%- assign mimg = blank -%}
            {%- for product in collection.products -%}
              {%- assign ptj = product.tags | join: '|' | downcase -%}
              {%- assign ptagstr = '|' | append: ptj | append: '|' -%}
              {%- if ptagstr contains mtag_key -%}
                {%- assign mcount = mcount | plus: 1 -%}
                {%- if mimg == blank -%}{%- assign mimg = product.featured_image -%}{%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if mcount > 0 -%}
              <button type="button" class="ec__model-card" data-model-tag="{{ mtag | escape }}" data-model-label="{{ mlabel | escape }}">
                {%- if mimg != blank -%}<img src="{{ mimg | image_url: width: 300 }}" alt="{{ mlabel | escape }}" loading="lazy" width="150" height="92">{%- endif -%}
                <b>{{ mlabel }}</b>
                <span>{{ mcount }} product{% if mcount != 1 %}s{% endif %}</span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </section>
      {%- endif -%}

      {%- comment -%} ================= SUB-CAROUSELS ================= {%- endcomment -%}
      {%- assign band_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'sub_carousel' -%}
          {%- assign block_total = block_counts_arr[forloop.index0] | plus: 0 -%}
          {%- if block_total > 0 -%}
            {%- assign band_index = band_index | plus: 1 -%}

            {%- liquid
              assign ftype = block.settings.filter_type | strip
              assign ftag = block.settings.filter_tag | strip | downcase
              assign sub_limit = block.settings.products_shown | default: 4
              assign match_count = 0
              assign local_shown = ','
              assign pool = collection.products
              if block.settings.source_collection != blank
                assign source_col = collections[block.settings.source_collection]
                if source_col.products.size > 0
                  assign pool = source_col.products
                endif
              endif
              assign vendor_passes = 1
              if block.settings.vendor_match
                assign vendor_passes = 2
              endif
            -%}

            {%- capture card_markup -%}
              {%- for dpass in (1..2) -%}
                {%- for vpass in (1..vendor_passes) -%}
                  {%- for product in pool -%}
                    {%- if match_count >= sub_limit -%}{%- break -%}{%- endif -%}
                    {%- assign pkey = ',' | append: product.handle | append: ',' -%}
                    {%- if local_shown contains pkey -%}{%- continue -%}{%- endif -%}
                    {%- if dpass == 1 and shown_global contains pkey -%}{%- continue -%}{%- endif -%}
                    {%- assign is_match = true -%}
                    {%- if ftype == blank and ftag == blank and vendor_passes == 1 -%}{%- assign is_match = false -%}{%- endif -%}
                    {%- if ftype != blank and product.type != ftype -%}{%- assign is_match = false -%}{%- endif -%}
                    {%- if is_match and ftag != blank -%}
                      {%- assign tag_string = product.tags | join: '|' | downcase -%}
                      {%- unless tag_string contains ftag -%}{%- assign is_match = false -%}{%- endunless -%}
                    {%- endif -%}
                    {%- if is_match and vendor_passes == 2 -%}
                      {%- assign vendor_dc = product.vendor | downcase -%}
                      {%- if vpass == 1 -%}
                        {%- unless vendor_dc == brand_dc -%}{%- assign is_match = false -%}{%- endunless -%}
                      {%- elsif vendor_dc == brand_dc -%}
                        {%- assign is_match = false -%}
                      {%- else -%}
                        {%- unless vendor_dc contains 'universal' -%}{%- assign is_match = false -%}{%- endunless -%}
                      {%- endif -%}
                    {%- endif -%}
                    {%- if is_match -%}
                      {%- assign match_count = match_count | plus: 1 -%}
                      {%- assign local_shown = local_shown | append: product.handle | append: ',' -%}
                      {%- assign shown_global = shown_global | append: product.handle | append: ',' -%}
                      <div class="ec__card-wrap">
                        {%- render 'grid-view-item', product: product, collection: collection, enable_badges: settings.show_badges, grid_count_desktop: 4, grid_count_mobile: 2, loading: 'lazy' -%}
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endfor -%}
              {%- endfor -%}
            {%- endcapture -%}

            {%- assign view_all_url = blank -%}
            {%- if block.settings.link_override != blank -%}
              {%- assign view_all_url = block.settings.link_override | replace: '[brand]', brand_url -%}
            {%- elsif block.settings.filter_param != blank -%}
              {%- assign view_all_url = collection.url | append: '?' | append: block.settings.filter_param -%}
            {%- endif -%}

            {%- assign band_class = '' -%}
            {%- assign band_check = band_index | modulo: 2 -%}
            {%- if band_check == 0 -%}{%- assign band_class = ' ec__sec--tint' -%}{%- endif -%}

            <section class="ec__sec{{ band_class }}" id="ec-{{ block.id }}" {{ block.shopify_attributes }}>
              <span class="ec__rule" aria-hidden="true"></span>
              <div class="ec__sec-head">
                <h2 class="ec__h2">{{ block.settings.heading | replace: '[brand]', brand }}</h2>
                {%- if view_all_url != blank and block_total > sub_limit -%}
                  <a href="{{ view_all_url }}" class="ec__view-all">{{ block.settings.cta | default: 'View all' }} ({{ block_total }}) &rarr;</a>
                {%- endif -%}
              </div>
              {%- assign desc_out = blank -%}
              {%- if block.settings.metafield_key != blank -%}
                {%- assign mf_obj = collection.metafields.custom[block.settings.metafield_key] -%}
                {%- capture desc_out -%}{{ mf_obj | metafield_tag }}{%- endcapture -%}
              {%- endif -%}
              {%- if desc_out != blank -%}
                <div class="ec__sec-desc rte">{{ desc_out }}</div>
              {%- elsif block.settings.description != blank -%}
                <div class="ec__sec-desc rte">{{ block.settings.description | replace: '[brand]', brand }}</div>
              {%- endif -%}
              <div class="ec__carousel">{{ card_markup }}</div>
            </section>

          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

    </div>

    {%- comment -%} ================= FEATURE BAND (kits) ================= {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'feature_band' -%}
        {%- assign band_show = true -%}
        {%- if block.settings.require_tag != blank -%}
          {%- assign band_show = false -%}
          {%- assign req = block.settings.require_tag | downcase -%}
          {%- for product in collection.products -%}
            {%- assign ptags = product.tags | join: '|' | downcase -%}
            {%- if ptags contains req -%}{%- assign band_show = true -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if band_show -%}
          {%- assign band_img = block.settings.image -%}
          {%- if band_img == blank and block.settings.require_tag != blank -%}
            {%- for product in collection.products -%}
              {%- assign ptags = product.tags | join: '|' | downcase -%}
              {%- if ptags contains req -%}{%- assign band_img = product.featured_image -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          <section class="ec__band" id="ec-band-{{ block.id }}" {{ block.shopify_attributes }}>
            <div class="ec__wrap ec__band-inner">
              <div class="ec__band-copy">
                {%- if block.settings.eyebrow != blank -%}<p class="ec__eyebrow ec__eyebrow--hero">{{ block.settings.eyebrow | replace: '[brand]', brand }}</p>{%- endif -%}
                <h2 class="ec__h2 ec__h2--band">{{ block.settings.heading | replace: '[brand]', brand }}</h2>
                {%- if block.settings.text != blank -%}<div class="ec__band-text rte">{{ block.settings.text | replace: '[brand]', brand }}</div>{%- endif -%}
                {%- if block.settings.chips != blank -%}
                  <div class="ec__grams">
                    {%- assign chip_list = block.settings.chips | split: ',' -%}
                    {%- for c in chip_list -%}<span>{{ c | strip }}</span>{%- endfor -%}
                  </div>
                {%- endif -%}
                {%- if block.settings.cta_label != blank and block.settings.cta_url != blank -%}
                  <a class="ec__btn" href="{{ block.settings.cta_url | replace: '[brand]', brand_url }}">{{ block.settings.cta_label }}</a>
                {%- endif -%}
              </div>
              {%- if band_img != blank -%}
                <div class="ec__band-visual"><img src="{{ band_img | image_url: width: 800 }}" alt="" loading="lazy"></div>
              {%- endif -%}
            </div>
          </section>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    <div class="ec__wrap">

      {%- comment -%} ================= HOW IT WORKS ================= {%- endcomment -%}
      {%- assign has_steps = false -%}
      {%- for block in section.blocks -%}{%- if block.type == 'how_step' -%}{%- assign has_steps = true -%}{%- endif -%}{%- endfor -%}
      {%- if has_steps -%}
      <section class="ec__sec" id="ec-how">
        <span class="ec__rule" aria-hidden="true"></span>
        <h2 class="ec__h2">{{ section.settings.how_heading | default: 'Dialled in, in three steps' | replace: '[brand]', brand }}</h2>
        <div class="ec__how">
          {%- for block in section.blocks -%}
            {%- if block.type == 'how_step' -%}
              <div class="ec__step" {{ block.shopify_attributes }}>
                <b>{{ forloop.index }} &middot; {{ block.settings.heading | replace: '[brand]', brand }}</b>
                <div class="rte">{{ block.settings.text | replace: '[brand]', brand }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </section>
      {%- endif -%}

      {%- comment -%} ================= SPLIT BLOCKS ================= {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'split_block' -%}
          {%- assign split_classes = 'ec__split ec__split--' | append: block.settings.image_position -%}
          {%- if block.settings.image == blank -%}{%- assign split_classes = split_classes | append: ' ec__split--noimg' -%}{%- endif -%}
          <div class="{{ split_classes }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="ec__split-img">{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy' }}</div>
            {%- endif -%}
            <div class="ec__split-text">
              {%- if block.settings.eyebrow != blank -%}<p class="ec__eyebrow">{{ block.settings.eyebrow | replace: '[brand]', brand }}</p>{%- endif -%}
              <h2 class="ec__h2 ec__h2--split">{{ block.settings.heading | replace: '[brand]', brand }}</h2>
              {%- if block.settings.text != blank -%}<div class="ec__split-body rte">{{ block.settings.text | replace: '[brand]', brand }}</div>{%- endif -%}
              {%- if block.settings.cta_label != blank and block.settings.cta_url != blank -%}
                <a href="{{ block.settings.cta_url }}" class="ec__btn ec__btn--ghost">{{ block.settings.cta_label }}</a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} ================= FAQS ================= {%- endcomment -%}
      {%- assign has_faq_blocks = false -%}
      {%- for block in section.blocks -%}{%- if block.type == 'faq' -%}{%- assign has_faq_blocks = true -%}{%- endif -%}{%- endfor -%}
      {%- if mf_faqs != blank or has_faq_blocks -%}
      <section class="ec__sec" id="ec-faqs">
        <span class="ec__rule" aria-hidden="true"></span>
        <h2 class="ec__h2">{{ section.settings.faq_heading | default: '[brand] golf club weights — FAQs' | replace: '[brand]', brand }}</h2>
        {%- if mf_faqs != blank -%}
          {%- comment -%} Per-collection FAQ content replaces the default blocks {%- endcomment -%}
          <div class="ec__faq-rte rte">{{ mf_faqs }}</div>
        {%- else -%}
          <div class="ec__faqs">
            {%- for block in section.blocks -%}
              {%- if block.type == 'faq' and block.settings.question != blank -%}
                <details class="ec__faq" {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
                  <summary><h3>{{ block.settings.question | replace: '[brand]', brand }}</h3><span class="ec__faq-x" aria-hidden="true">+</span></summary>
                  <div class="ec__faq-a rte">{{ block.settings.answer | replace: '[brand]', brand }}</div>
                </details>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": [
              {%- assign faq_first = true -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'faq' and block.settings.question != blank -%}
                  {%- unless faq_first -%},{%- endunless -%}
                  {%- assign faq_first = false -%}
                  {
                    "@type": "Question",
                    "name": {{ block.settings.question | replace: '[brand]', brand | json }},
                    "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | replace: '[brand]', brand | strip_html | json }} }
                  }
                {%- endif -%}
              {%- endfor -%}
            ]
          }
          </script>
        {%- endif -%}
      </section>
      {%- endif -%}

    </div>
  </div>

  {%- comment -%} ---- product data for the fit finder ---- {%- endcomment -%}
  {%- if section.settings.show_finder and models_raw != blank -%}
  <script type="application/json" id="ecProductData">
  {
    "models": [
      {%- assign mj_first = true -%}
      {%- for line in model_lines -%}
        {%- assign mparts = line | split: '|' -%}
        {%- assign mlabel = mparts[0] | strip -%}
        {%- assign mtag = mparts[1] | strip | downcase -%}
        {%- assign mclubs = mparts[2] | strip | downcase | replace: ' ', '' -%}
        {%- if mlabel == blank or mtag == blank -%}{%- continue -%}{%- endif -%}
        {%- unless mj_first -%},{%- endunless -%}{%- assign mj_first = false -%}
        { "label": {{ mlabel | json }}, "tag": {{ mtag | json }}, "clubs": {{ mclubs | json }} }
      {%- endfor -%}
    ],
    "products": [
      {%- assign pj_first = true -%}
      {%- for product in collection.products -%}
        {%- assign clubs = '' -%}
        {%- assign ptags = product.tags | join: '|' | downcase -%}
        {%- if product.type == 'Weights for Woods' -%}
          {%- if ptags contains 'driver' -%}{%- assign clubs = clubs | append: 'driver,' -%}{%- endif -%}
          {%- if ptags contains 'fairway' -%}{%- assign clubs = clubs | append: 'fairway,' -%}{%- endif -%}
          {%- if ptags contains 'hybrid' -%}{%- assign clubs = clubs | append: 'hybrid,' -%}{%- endif -%}
        {%- elsif product.type == 'Weights for Irons' -%}
          {%- assign clubs = 'iron,' -%}
        {%- elsif product.type == 'Weights for Putters' -%}
          {%- assign clubs = 'putter,' -%}
        {%- endif -%}
        {%- if clubs == '' -%}{%- continue -%}{%- endif -%}
        {%- unless pj_first -%},{%- endunless -%}{%- assign pj_first = false -%}
        {%- assign ptj = product.tags | join: '|' | downcase -%}
        {%- assign ptagstr = '|' | append: ptj | append: '|' -%}
        {
          "title": {{ product.title | json }},
          "url": {{ product.url | json }},
          "price": {{ product.price_min | money | strip_html | json }},
          "img": {{ product.featured_image | image_url: width: 300 | json }},
          "tags": {{ ptagstr | json }},
          "clubs": {{ clubs | json }}
        }
      {%- endfor -%}
    ]
  }
  </script>
  {%- endif -%}

  <script>
    (function () {
      /* ---------- fit finder ---------- */
      var dataEl = document.getElementById('ecProductData');
      if (dataEl) {
        var DATA = JSON.parse(dataEl.textContent);
        var club = null, modelTag = null, modelLabel = null;
        var seg = document.getElementById('ecClubSeg');
        var chips = document.getElementById('ecModelChips');
        var results = document.getElementById('ecFinderResults');
        var frRow = document.getElementById('ecFrRow');
        var frTitle = document.getElementById('ecFrTitle');
        var clearBtn = document.getElementById('ecFrClear');

        function productMatches(p) {
          if (p.clubs.indexOf(club + ',') === -1) return false;
          if (modelTag && p.tags.indexOf('|' + modelTag + '|') === -1) return false;
          return true;
        }
        function render() {
          if (!club) { results.hidden = true; return; }
          var hits = DATA.products.filter(productMatches);
          frTitle.textContent = hits.length + (hits.length === 1 ? ' weight fits' : ' weights fit') + ' your ' + (modelLabel ? modelLabel + ' ' : '') + club;
          frRow.innerHTML = hits.map(function (p) {
            return '<a class="ec__jcard" href="' + p.url + '">' +
              (p.img ? '<span class="ec__jcard-ph"><img src="' + p.img + '" alt="" loading="lazy"></span>' : '') +
              '<span class="ec__jcard-t">' + p.title + '</span>' +
              '<span class="ec__jcard-p">from ' + p.price + '</span></a>';
          }).join('');
          results.hidden = false;
        }
        function selectClub(c, btn) {
          club = c; modelTag = null; modelLabel = null;
          seg.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === btn ? 'true' : 'false'); });
          chips.innerHTML = '';
          DATA.models.forEach(function (m) {
            if (m.clubs.split(',').indexOf(club) === -1) return;
            var hasProducts = DATA.products.some(function (p) {
              return p.clubs.indexOf(club + ',') > -1 && p.tags.indexOf('|' + m.tag + '|') > -1;
            });
            if (!hasProducts) return;
            var b = document.createElement('button');
            b.type = 'button'; b.textContent = m.label; b.setAttribute('aria-pressed', 'false');
            b.addEventListener('click', function () {
              modelTag = m.tag; modelLabel = m.label;
              chips.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
              render();
            });
            chips.appendChild(b);
          });
          render();
        }
        if (seg) {
          seg.addEventListener('click', function (e) {
            var b = e.target.closest('button'); if (!b) return;
            selectClub(b.dataset.club, b);
          });
        }
        if (clearBtn) {
          clearBtn.addEventListener('click', function () {
            club = null; modelTag = null; modelLabel = null;
            seg.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', 'false'); });
            chips.innerHTML = '<span class="ec__hint">Pick a club type first…</span>';
            results.hidden = true;
          });
        }
        /* model rail cards drive the finder too */
        document.querySelectorAll('.ec__model-card').forEach(function (card) {
          card.addEventListener('click', function () {
            var tag = card.dataset.modelTag, label = card.dataset.modelLabel;
            var m = null;
            for (var i = 0; i < DATA.models.length; i++) { if (DATA.models[i].tag === tag) { m = DATA.models[i]; break; } }
            var firstClub = m ? m.clubs.split(',')[0] : 'driver';
            var btn = seg ? seg.querySelector('[data-club="' + firstClub + '"]') : null;
            if (btn) {
              selectClub(firstClub, btn);
              modelTag = tag; modelLabel = label;
              chips.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x.textContent === label ? 'true' : 'false'); });
              render();
              var finder = document.querySelector('.ec__finder');
              if (finder) finder.scrollIntoView({ block: 'start' });
            }
          });
        });
      }

      /* ---------- scrollspy ---------- */
      var nav = document.getElementById('ecSubnav');
      if (nav && 'IntersectionObserver' in window) {
        var links = Array.prototype.slice.call(nav.querySelectorAll('a'));
        var obs = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) {
              links.forEach(function (l) { l.classList.toggle('on', l.getAttribute('href') === '#' + en.target.id); });
            }
          });
        }, { rootMargin: '-20% 0px -70% 0px' });
        links.forEach(function (l) {
          var el = document.querySelector(l.getAttribute('href'));
          if (el) obs.observe(el);
        });
      }
    })();
  </script>

{%- endif -%}

<style>
